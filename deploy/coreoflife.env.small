# Küçük sunucu (2 çekirdek / 2 GB RAM) için başlangıç ayarı. Büyüyünce coreoflife.env.example'a geç.
NODE_ENV=production
PORT=8080
HOST=127.0.0.1
DATABASE_URL=postgres://coreoflife:GUCLU_PAROLA@127.0.0.1:5432/coreoflife
# 2 çekirdek: 1 kanal (oyun simülasyonu) + ana süreç; PostgreSQL boşta bekler
CHANNELS=1
CHANNEL_CAPACITY=120
REALM_CAPACITY=120
AOI_MAX_PLAYERS=40
# Node bellek tavanı (MB): 2 GB RAM'de PostgreSQL ve sisteme yer kalsın
NODE_HEAP_MB=900
