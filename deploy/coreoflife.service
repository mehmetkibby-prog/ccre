[Unit]
Description=Core of Life oyun sunucusu
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=coreoflife
WorkingDirectory=/opt/coreoflife/current
# Bellek tavanı ortam dosyasında NODE_HEAP_MB ile değişir (küçük sunucu: 900)
Environment=NODE_HEAP_MB=2048
EnvironmentFile=/etc/coreoflife.env
ExecStart=/usr/bin/node --max-old-space-size=${NODE_HEAP_MB} packages/server/dist/main.js
# Düzgün kapanış: SIGTERM ile herkes kaydedilir
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
